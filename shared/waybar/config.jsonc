{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 5,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["idle_inhibitor", "pulseaudio", "network", "bluetooth", "backlight", "battery", "cpu", "memory", "temperature", "tray"],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {"1":"󰈹","2":"󰆍","3":"󰙯","4":"󰓓","5":"󰝚","urgent":"","default":""},
    "persistent-workspaces": {"*":[1,2,3,4,5]}
  },
  "hyprland/window": {"format":"{}","max-length":48,"separate-outputs":true},
  "clock": {
    "format": "󰥔  {:%a %d %b  ·  %I:%M %p}",
    "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt>{calendar}</tt>"
  },
  "idle_inhibitor": {"format":"{icon}","format-icons":{"activated":"󰈈","deactivated":"󰈉"},"tooltip":true},
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": {"default":["󰕿","󰖀","󰕾"]},
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤭 offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {"format":"󰂯","format-connected":"󰂱 {num_connections}","on-click":"blueman-manager"},
  "backlight": {"format":"󰃞 {percent}%"},
  "battery": {
    "states":{"warning":30,"critical":15},
    "format":"{icon} {capacity}%",
    "format-charging":"󰂄 {capacity}%",
    "format-plugged":"󰚥 {capacity}%",
    "format-icons":["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "tooltip-format":"{timeTo} remaining · {power} W"
  },
  "cpu":{"format":"󰻠 {usage}%","tooltip":true},
  "memory":{"format":"󰍛 {percentage}%","tooltip-format":"RAM: {used:0.1f}G / {total:0.1f}G"},
  "temperature":{"critical-threshold":85,"format":"󰔏 {temperatureC}°C","tooltip":true},
  "tray":{"spacing":8}
}
